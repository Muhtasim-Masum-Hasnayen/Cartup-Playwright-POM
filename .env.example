# Cartup test account
# IMPORTANT:
# For the exact signup -> login flow, leave TEST_EMAIL/TEST_PHONE empty
# and run the test. The browser will pause at OTP so you can enter it manually.
#
# For repeatable runs after you already have an account, set these values
# and use the existing-account mode in the test.

CARTUP_EMAIL=
CARTUP_PHONE=
CARTUP_PASSWORD=Cartup@12345

# Set to true only when you want to reuse an existing account.
USE_EXISTING_ACCOUNT=false

# Medium visual speed. 700ms is intentionally not too slow.
ACTION_DELAY_MS=700

# Keep browser visible by default for portfolio demonstration.
HEADLESS=false
